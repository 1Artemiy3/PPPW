<Window x:Class="MotorDepotApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система 'Автобаза' — Диспетчерська" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель дій -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="📅 1. Згенерувати заявки на день" 
                    Command="{Binding GenerateRequestsCommand}" 
                    Padding="10,6" Margin="0,0,10,0" FontWeight="Bold"/>
            <Button Content="🚛 2. Розподілити заявки (Диспетчер)" 
                    Command="{Binding DispatchAllCommand}" 
                    Padding="10,6" Margin="0,0,10,0" Background="#E1F5FE" FontWeight="Bold"/>
        </StackPanel>

        <!-- Верхня сітка: Заявки та Рейси -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Список заявок -->
            <GroupBox Header="Нові щоденні заявки на перевезення" Grid.Column="0" Margin="0,0,5,0">
                <DataGrid ItemsSource="{Binding PendingRequests}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Куди" Binding="{Binding Destination}" Width="*"/>
                        <DataGridTextColumn Header="Тип вантажу" Binding="{Binding CargoType.Name}" Width="1.2*"/>
                        <DataGridTextColumn Header="Вага (кг)" Binding="{Binding CargoWeightKg}" Width="*"/>
                        <DataGridTextColumn Header="Відстань (км)" Binding="{Binding DistanceKm}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Активні рейси та керування ними -->
            <GroupBox Header="Рейси у процесі виконання (оберіть рейс для дій водія)" Grid.Column="1" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding ActiveTrips}" SelectedItem="{Binding SelectedTrip}" 
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Куди" Binding="{Binding Request.Destination}" Width="*"/>
                            <DataGridTextColumn Header="Водій" Binding="{Binding Driver.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Автомобіль" Binding="{Binding Vehicle.Model}" Width="*"/>
                            <DataGridTextColumn Header="Стан рейсу" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Журнал" Binding="{Binding Logs}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Панель взаємодії водія -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="▶ Просунути рейс / Завершити" Command="{Binding SimulateStepCommand}" Margin="5,0" Padding="8,4"/>
                        <Button Content="🛠 Заявка на ремонт" Command="{Binding RequestRepairCommand}" Margin="5,0" Padding="8,4"/>
                        <Button Content="✅ Виконати ремонт СТО" Command="{Binding RepairVehicleCommand}" Margin="5,0" Padding="8,4"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Нижня сітка: Стан водіїв та автомобілів -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Водії -->
            <GroupBox Header="Штат водіїв (Стаж / Виплати)" Grid.Column="0" Margin="0,0,5,0">
                <DataGrid ItemsSource="{Binding Drivers}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ПІБ Водія" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Стаж (років)" Binding="{Binding ExperienceYears}" Width="80"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Зароблені кошти" Binding="{Binding Balance, StringFormat={}{0:C0}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Автопарк -->
            <GroupBox Header="Автомобілі (Вантажопідйомність / Складність)" Grid.Column="1" Margin="5,0,0,0">
                <DataGrid ItemsSource="{Binding Vehicles}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="Вантажопідйомність" Binding="{Binding LoadCapacityKg, StringFormat={}{0} кг}" Width="120"/>
                        <DataGridTextColumn Header="Складність" Binding="{Binding DrivingComplexity}" Width="80"/>
                        <DataGridTextColumn Header="Стан машини" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
